{# Left vertical toolbar to host expandable buttons (keeps future buttons easy to add) #}
<nav id="left-toolbar" aria-label="Left toolbar" role="toolbar" aria-orientation="vertical">
    <div id="left-toolbar-inner">
        <!-- Toolbar buttons container -->
        <div id="toolbar-buttons">
            <button id="burger-toggle-btn" class="action-button toolbar-button" title="Open menu"
                aria-label="Open menu">
                {{ '/icons/burger.svg' | inline_svg }}
            </button>

            <!-- Theme toggle moved here from the top toolbar -->
            <button id="theme-toggle-btn" class="action-button toolbar-button" title="Toggle Theme"
                aria-label="Toggle theme" aria-pressed="false" tabindex="-1">
                {{ '/icons/theme.svg' | inline_svg }}
            </button>
            <button class="action-button toolbar-button" id="menu-button" title="Instructions" aria-label="Instructions"
                aria-pressed="false" tabindex="0">
                {{ '/icons/sliders.svg' | inline_svg }}
            </button>
            <!-- Schema button (replaces analytics) -->
            <button class="action-button toolbar-button" id="schema-button" title="Schema" aria-label="Open schema"
                aria-pressed="false" tabindex="-1">
                <!-- Simple database/schema icon: cylinder + table nodes -->
                {{ '/icons/waypoints.svg' | inline_svg }}
            </button>
        </div>
    </div>
    <div id="left-toolbar-footer">
        <div id="toolbar-footer-buttons">
            <button class="connect-database-btn action-button toolbar-button toolbar-footer-button" title="Add database"
                aria-label="Add database" tabindex="0">
                <!-- database + icon -->
                {{ '/icons/db-large.svg' | inline_svg }}
            </button>

            <button id="support-btn" class="action-button toolbar-button toolbar-footer-button" title="Support"
                aria-label="Support" tabindex="0">
                <!-- lifebuoy/support icon -->
                {{ '/icons/support.svg' | inline_svg }}
            </button>

            <button id="settings-btn" class="action-button toolbar-button toolbar-footer-button" title="Settings"
                aria-label="Settings" tabindex="0">
                <!-- gear icon -->
                {{ '/icons/settings.svg' | inline_svg }}
            </button>
        </div>
    </div>
</nav>